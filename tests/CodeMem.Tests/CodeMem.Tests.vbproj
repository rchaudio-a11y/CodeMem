<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>CodeMem.Tests</RootNamespace>
    <OptionStrict>On</OptionStrict>
    <OptionExplicit>On</OptionExplicit>
    <OptionInfer>Off</OptionInfer>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <!-- Fixture sources are a separate solution loaded by the tests; they never compile into this assembly. -->
    <Compile Remove="Fixtures/**" />
  </ItemGroup>

  <ItemGroup>
    <!-- The version-1 map fixture (research R30): copied beside the tests so V1MapFixture can copy it to a temp path. -->
    <None Update="Fixtures/Maps/sample-v1.sqlite" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CodeMem.Core\CodeMem.Core.vbproj" />
    <ProjectReference Include="..\..\src\CodeMem.Extraction\CodeMem.Extraction.vbproj" />
    <ProjectReference Include="..\..\src\CodeMem.Extractor\CodeMem.Extractor.vbproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Xunit.SkippableFact" Version="1.5.85" />
  </ItemGroup>

</Project>
