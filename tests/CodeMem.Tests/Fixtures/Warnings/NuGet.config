<?xml version="1.0" encoding="utf-8"?>
<!-- Feature 005 (research R71): the warning fixtures restore from the local folder beside them and nothing else, so the suite
     stays offline. Nu1701 finds CodeMem.NetFxOnly here (a .NET Framework-only package: NU1701); Nu1101 asks for a package this
     folder does not hold (NU1101 from a source that exists, never NU1301). -->
<configuration>
  <packageSources>
    <clear />
    <add key="local" value="packages" />
  </packageSources>
</configuration>
