<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>CodeMem.Bridge</RootNamespace>
    <OptionStrict>On</OptionStrict>
    <OptionExplicit>On</OptionExplicit>
    <OptionInfer>Off</OptionInfer>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Feature 004 (CON1): the entry point, the command line and the MCP host wiring; nothing else. -->
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CodeMem.Bridging\CodeMem.Bridging.vbproj" />
    <!-- The extractor lands beside the bridge, so the default extractorPath resolves (research R47). -->
    <ProjectReference Include="..\CodeMem.Extractor\CodeMem.Extractor.vbproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shipped in the tree, not beside the executable: the Operator copies the sample config and merges the fragment by hand (FR-336, Q11). -->
    <None Update="bridge.config.sample.json" CopyToOutputDirectory="Never" />
    <None Update="hooks\settings.fragment.json" CopyToOutputDirectory="Never" />
  </ItemGroup>

</Project>
