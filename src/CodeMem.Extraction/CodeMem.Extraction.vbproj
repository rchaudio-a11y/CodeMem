<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>CodeMem.Extraction</RootNamespace>
    <OptionStrict>On</OptionStrict>
    <OptionExplicit>On</OptionExplicit>
    <OptionInfer>Off</OptionInfer>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Fixpack 003 (research R38, FR-217): the fact set for one digest changed (out-of-scope rows leave, bare-name edges arrive). -->
    <!-- Feature 005 (FR-421, FR-427): two input changes - a .slnx opens through CodeMem's own parse, and a NuGet restore warning no longer
         fails the load (it is recorded on the run); the summary line gains warnings=<n>. -->
    <Version>0.3.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CodeMem.Core\CodeMem.Core.vbproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.VisualBasic.Workspaces" Version="4.14.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="4.14.0" />
    <PackageReference Include="LibGit2Sharp" Version="0.32.0" />
    <!-- Fixpack 002 (research R25): transitive pins. Microsoft.Build.Tasks.Core 17.8.43 clears GHSA-h4j7-5rxr-p4wc and
         GHSA-w3q9-fxm7-j8fq (17.8.29 clears the first but surfaces the second); System.Formats.Asn1 8.0.1 clears GHSA-447r-wph3-92pm. -->
    <PackageReference Include="Microsoft.Build.Tasks.Core" Version="17.8.43" />
    <PackageReference Include="System.Formats.Asn1" Version="8.0.1" />
  </ItemGroup>

</Project>
